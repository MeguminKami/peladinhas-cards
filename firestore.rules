rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  match /homeSignals/{uid} {
   allow get: if active() && (uid == 'global' || uid == request.auth.uid);
   allow list, write: if false;
  }
  match /eventSignals/{id} {
   allow get: if active();
   allow list, write: if false;
  }
  function freshTokens() { let path=/databases/$(database)/documents/users/$(request.auth.uid); return !exists(path) || request.auth.token.get('auth_time',0)>=get(path).data.get('tokensValidAfter',0); }
  function active() { return signedIn() && freshTokens() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false; }
  function owner(uid) { return signedIn() && freshTokens() && request.auth.uid == uid; }
  function admin() { return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
  function systemConfig() {
    let path=/databases/$(database)/documents/settings/system;
    let existsConfig=exists(path);
    let timeline=existsConfig ? get(path).data.get('timeline',[]) : [];
    let size=timeline.size();
    let latest=size>0 ? timeline[size-1] : {};
    return size==0 ? {} : latest.get('effectiveMillis',0)<=request.time.toMillis() ? latest.config : size>1 ? timeline[size-2].config : {};
  }
  function writable(feature) { let config=systemConfig(); return config.get('features',{}).get('mode','normal')=='normal' && config.get('features',{}).get(feature,true)==true; }
  function capable(cap) { return admin() && (!('adminCapabilities' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminCapabilities==null || cap in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminCapabilities); }
  function attrs() { return ['pace','shooting','passing','dribbling','defending','physical','goalkeeping','stamina','vision','positioning','teamwork','composure']; }
  function optionalRating(r,k,max) { return !(k in r) || (r[k] is int && r[k]>=0 && r[k]<=max); }
  function validInitial(r) { return r is map && r.keys().hasOnly(attrs()) && optionalRating(r,'pace',20) && optionalRating(r,'shooting',20) && optionalRating(r,'passing',20) && optionalRating(r,'dribbling',20) && optionalRating(r,'defending',20) && optionalRating(r,'physical',20) && optionalRating(r,'goalkeeping',20) && optionalRating(r,'stamina',20) && optionalRating(r,'vision',20) && optionalRating(r,'positioning',20) && optionalRating(r,'teamwork',20) && optionalRating(r,'composure',20); }
  function validProfile(p) { return p.displayName is string && p.displayName.size()<=30 && p.countryCode is string && p.countryCode.matches('^[A-Z]{2}$') && p.country is string && p.photoURL is string && p.photoURL.size()<=2000 && (!('heightCm' in p) || (p.heightCm is int && p.heightCm>=120 && p.heightCm<=230)) && (!('weightKg' in p) || p.weightKg==null || (p.weightKg is number && p.weightKg>=30 && p.weightKg<=250)) && (!('birthDate' in p) || (p.birthDate is string && p.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) && (!('preferredFoot' in p) || p.preferredFoot in ['right','left','both']) && (!('primaryPosition' in p) || p.primaryPosition in ['GR','DEF','ALA','MED','AV']) && (!('secondaryPositions' in p) || (p.secondaryPositions is list && p.secondaryPositions.toSet().hasOnly(['GR','DEF','ALA','MED','AV']))) && (!('shirtNumber' in p) || p.shirtNumber==null || (p.shirtNumber is int && p.shirtNumber>=0 && p.shirtNumber<=99)) && (!('city' in p) || (p.city is string && p.city.size()<=60)) && (!('playerStyle' in p) || (p.playerStyle is string && p.playerStyle.size()<=80)); }
  match /users/{uid} {
   allow read: if active() || owner(uid);
   allow create: if writable('registration') && !request.resource.data.keys().hasAny(['adminCapabilities','tokensValidAfter']) && owner(uid) && request.resource.data.uid==uid && request.resource.data.role=='member' && request.resource.data.disabled==false && request.resource.data.username.matches('^[a-z0-9_.-]{3,20}$') && request.auth.token.email==request.resource.data.username+'@auth.weeklyfc.app' && validProfile(request.resource.data) && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if writable('profile') && validProfile(request.resource.data) && request.resource.data.uid==resource.data.uid && request.resource.data.username==resource.data.username && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.updatedAt==request.time && ((capable('access') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','disabled','adminCapabilities','tokensValidAfter'])) || (active() && owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','country','countryCode','photoURL','birthDate','heightCm','weightKg','preferredFoot','primaryPosition','secondaryPositions','shirtNumber','city','playerStyle','profileCompleted','updatedAt'])));
   allow delete: if false;
   match /cardHistory/{week} { allow read: if active(); allow write: if false; }
   match /notifications/{id} {
    allow read: if owner(uid) && active();
    allow create: if systemConfig().get('notifications',{}).get('enabled',true) && owner(uid) && active() && id.matches('^mission-.*') && request.resource.data.keys().hasOnly(['type','title','body','href','read','createdAt']) && request.resource.data.type in ['NEW_MISSION','NEW_PLAYER_TO_RATE','RATING_REQUIRED'] && request.resource.data.title is string && request.resource.data.title.size()<=150 && request.resource.data.body is string && request.resource.data.body.size()<=500 && request.resource.data.href.matches('^#/.*') && request.resource.data.read==false && request.resource.data.createdAt==request.time;
    allow update: if owner(uid) && active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
   }
  }
  function submittedTime(d) { return d.get('submittedAt',null) is timestamp ? d.submittedAt : d.createdAt; }
  function ratingEditable(d,key) { return !d.get(key,false) || request.time < submittedTime(d) + duration.value(d.get('editDays',7),'d'); }
  function keepsSubmission(old,next,key) { return old.get(key,false) ? next[key] && next.get('submittedAt',null)==submittedTime(old) && next.get('editDays',7)==old.get('editDays',7) : (!next[key] || next.submittedAt==request.time && next.get('editDays',7)==systemConfig().get('rules',{}).get('ratingEditDays',7)); }
  // A autoavaliação é pública; as avaliações externas permanecem privadas.
  match /initialRatings/{uid} {
   allow read: if active();
   allow create: if writable('ratings') && (owner(uid)&&active() || capable('ratings')) && request.resource.data.keys().hasOnly(['uid','ratings20','completed','createdAt','updatedAt','submittedAt','editDays']) && request.resource.data.uid==uid && validInitial(request.resource.data.ratings20) && request.resource.data.completed is bool && (!request.resource.data.completed || request.resource.data.ratings20.keys().hasAll(attrs())) && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time && (!request.resource.data.completed || request.resource.data.submittedAt==request.time && request.resource.data.get('editDays',7)==systemConfig().get('rules',{}).get('ratingEditDays',7));
   allow update: if writable('ratings') && (owner(uid)&&active() || capable('ratings')) && request.resource.data.uid==resource.data.uid && request.resource.data.createdAt==resource.data.createdAt && validInitial(request.resource.data.ratings20) && request.resource.data.completed is bool && (!request.resource.data.completed || request.resource.data.ratings20.keys().hasAll(attrs())) && request.resource.data.updatedAt==request.time && request.resource.data.keys().hasOnly(['uid','ratings20','completed','createdAt','updatedAt','submittedAt','editDays']) && ratingEditable(resource.data,'completed') && keepsSubmission(resource.data,request.resource.data,'completed');
  }
  match /communityRatings/{id} {
   allow read: if capable('ratings') || (active() && resource.data.raterId==request.auth.uid);
   allow get: if active() && id.matches('^'+request.auth.uid+'_.*') && !exists(/databases/$(database)/documents/communityRatings/$(id));
   function validVote() { let d=request.resource.data; return d.keys().hasOnly(['raterId','targetId','ratings20','submitted','createdAt','updatedAt','submittedAt','editDays']) && d.raterId==request.auth.uid && d.targetId!=request.auth.uid && exists(/databases/$(database)/documents/users/$(d.targetId)) && id==d.raterId+'_'+d.targetId && validInitial(d.ratings20) && d.submitted is bool && (!d.submitted || d.ratings20.keys().hasAll(attrs())) && d.updatedAt==request.time && (!d.submitted || d.submittedAt is timestamp); }
   allow create: if writable('ratings') && active() && validVote() && request.resource.data.createdAt==request.time && (!request.resource.data.submitted || request.resource.data.submittedAt==request.time && request.resource.data.get('editDays',7)==systemConfig().get('rules',{}).get('ratingEditDays',7));
   allow update: if writable('ratings') && active() && validVote() && (!resource.data.submitted || request.resource.data.submitted) && request.resource.data.raterId==resource.data.raterId && request.resource.data.targetId==resource.data.targetId && request.resource.data.createdAt==resource.data.createdAt && ratingEditable(resource.data,'submitted') && keepsSubmission(resource.data,request.resource.data,'submitted');
  }
  match /communitySummaries/{uid} { allow read: if active(); allow write: if false; }
  match /gameSummaries/{gid} { allow read: if active(); allow write: if false; }
  match /games/{gid} {
   allow read: if active();
   // Lifecycle and path freezing are one trusted transaction.
   allow create, update: if false;
   allow delete: if false;
   match /feedback/{id} {
    allow read: if capable('ratings') || (active() && resource.data.raterId==request.auth.uid);
    allow get: if active() && id.matches('^'+request.auth.uid+'_.*') && !exists(/databases/$(database)/documents/games/$(gid)/feedback/$(id));
    // Every write must append its immutable vote revision atomically.
    allow create, update: if false;
   }
  }
  match /weeklyCardPhotos/{id} { allow read: if active(); allow write: if false; }
  match /weeklyCards/{uid} { allow read: if active(); allow write: if false; }
  match /cardCollections/{uid} { allow read: if active(); allow write: if false; }
  match /pathStates/{uid} {
   allow read: if active() && (owner(uid) || capable('events'));
   allow write: if false;
   match /audit/{id} { allow read: if capable('events'); allow write: if false; }
   match /attempts/{id} { allow read: if active() && (owner(uid) || capable('events')); allow write: if false; }
  }
  match /cardSelections/{uid} { allow read: if active(); allow write: if false; }
  match /cardPeriodAwards/{id} { allow read: if active(); allow write: if false; }
  match /gameBalances/{id} { allow read: if active(); allow write: if false; }
  match /events/{id} { allow read: if capable('events') || capable('audit') || active() && resource.data.status!='draft' && resource.data.get('rewardPrivacy',0)==1 && resource.data.get('prerequisites',{}).get('missionIds',[]).size()==0; allow write: if false;
    match /votes/{uid} { allow read: if active() && (owner(uid) || admin()); allow write: if false; }
    match /audit/{document} { allow read: if capable('events') || capable('audit'); allow write: if false; }
    match /private/{document} { allow read: if capable('events'); allow write: if false; }
  }
  match /eventRewards/{id} { allow read: if active(); allow write: if false; }
  match /ovrPresets/{id} { allow read: if capable('cards'); allow write: if false; }
  match /settings/system { allow read: if true; allow write: if false; }
  match /systemAudit/{id} { allow read: if capable('audit'); allow write: if false; }
  match /systemVersions/{id} { allow read: if capable('audit') || capable('settings'); allow write: if false; }
  match /systemDrafts/{uid} { allow read: if owner(uid) && capable('settings'); allow write: if false; }
  match /systemJobs/{id} { allow read: if capable('operations'); allow write: if false; }
  match /systemStatus/{id} { allow read: if admin(); allow write: if false; }
  match /settings/ovr { allow read: if active(); allow write: if false; }
  match /cardThemes/{id} { allow read: if capable('cards'); allow write: if false; }
  match /tickets/{id} {
   allow read: if active() && (capable('support') || resource.data.ownerId==request.auth.uid);
   allow write: if false;
   match /messages/{mid} {
    allow read: if active() && (capable('support') || get(/databases/$(database)/documents/tickets/$(id)).data.ownerId==request.auth.uid);
    allow write: if false;
   }
  }
  match /ratingCorrections/{id} { allow read: if capable('ratings') || capable('audit'); allow write: if false; }
  // Push endpoints and read capabilities belong exclusively to trusted Functions.
  match /pushDevices/{id} { allow read, write: if false; }
  match /pushDeliveries/{id} { allow read, write: if false; }
 }
}
