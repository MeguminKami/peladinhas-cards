rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function active() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.disabled==false && request.auth.token.get('auth_time',0)>=firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('tokensValidAfter',0); }
    function admin() {
      let user=firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return active() && user.role=='admin' && (!('adminCapabilities' in user) || user.adminCapabilities==null || 'access' in user.adminCapabilities);
    }
    function writable() {
      let path=/databases/(default)/documents/settings/system;
      let timeline=firestore.exists(path) ? firestore.get(path).data.get('timeline',[]) : [];
      let size=timeline.size();
      let latest=size>0 ? timeline[size-1] : {};
      let config=size==0 ? {} : latest.get('effectiveMillis',0)<=request.time.toMillis() ? latest.config : size>1 ? timeline[size-2].config : {};
      return config.get('features',{}).get('mode','normal')=='normal';
    }

    // Um avatar por utilizador: só imagens até 1 MB na pasta do próprio.
    match /profiles/{uid}/{fileName} {
      allow read: if active();
      allow create, update: if writable() && ((active() && request.auth.uid == uid) || admin())
        && fileName == 'avatar'
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if writable() && ((active() && request.auth.uid == uid) || admin());
    }
  }
}
