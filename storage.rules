rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Um avatar por utilizador: só imagens até 1 MB na pasta do próprio.
    match /profiles/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if ((signedIn() && request.auth.uid == uid) || admin())
        && fileName == 'avatar'
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if (signedIn() && request.auth.uid == uid) || admin();
    }
  }
}
