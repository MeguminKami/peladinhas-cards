{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": ".",
      "codebase": "peladinhas",
      "ignore": [
        "node_modules",
        ".git",
        ".deploy",
        "tests",
        "scripts",
        "css",
        "assets",
        "design",
        "games",
        "casino_temp",
        "docs",
        ".repository-export",
        "README.md",
        ".codex",
        ".agents",
        "js/config.js",
        "playwright-report",
        "test-results",
        "*-debug.log",
        "firebase.backend.json",
        "firebase.cycles.json",
        "firebase.cycles.json",
        "firebase.cycles.json",
        "firebase.casino.json",
        ".firebase",
        ".env*",
        ".secret.local",
        "firebase.maintenance.json",
        "firebase.read-budget.json"
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": {
      "port": 8085
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "hosting": {
      "port": 5000
    }
  },
  "hosting": {
    "redirects": [{ "source": "/casino", "destination": "/#/casino", "type": 302 }],
    "public": ".firebase/site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "regex": ".*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build:hosting"
    ]
  }
}
